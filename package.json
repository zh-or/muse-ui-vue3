{
  "name": "muse-ui-vue3",
  "version": "4.0.0",
  "description": "Material Design UI library for Vue 3",
  "author": "myronliu347 <myronliu347@gmail.com>",
  "repository": "https://github.com/museui/muse-ui.git",
  "main": "dist/muse-ui-vue3.cjs.js",
  "module": "dist/muse-ui-vue3.es.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/muse-ui-vue3.es.js",
      "require": "./dist/muse-ui-vue3.cjs.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "types"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .js,.ts"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^30.0.1",
    "less": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0",
    "vue": "^3.3.0",
    "vue-tsc": "^1.8.0"
  },
  "dependencies": {
    "body-scroll-lock": "^4.0.0-beta.0",
    "dayjs": "^1.11.0",
    "keycode": "^2.2.1",
    "normalize-wheel": "^1.0.1",
    "resize-observer-polyfill": "^1.5.1"
  }
}
